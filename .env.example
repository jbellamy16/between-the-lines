# Inference is opt-in. Never use NEXT_PUBLIC for secrets.
AI_ENABLED=false
AI_PROVIDER=offline
# AI_PROVIDER=openai | foundry | offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_DEPLOYMENT=
# Legacy Foundry opt-in is recognized only if AI_ENABLED and AI_PROVIDER are absent.
FOUNDRY_ENABLED=false
# Shared Redis required in production. Use an existing TLS Redis deployment.
AI_REDIS_URL=
# memory is allowed only outside production, for isolated local testing.
AI_USAGE_STORE=redis
# Dollar ceiling for ALL provider calls (Ask the Analyst, story review, guided
# questions). Each attempt reserves its worst case (1 token per payload byte +
# full output) before dispatch; never refunded. Required in production.
# Use separate ledger names so testing never spends the judging allowance.
AI_SPEND_CEILING_USD=
AI_SPEND_LEDGER=default
# Retail USD per million tokens (defaults: GPT-5.4 Mini Global Standard).
AI_PRICE_INPUT_PER_MTOK=0.75
AI_PRICE_OUTPUT_PER_MTOK=4.5
# Ask the Analyst: questions per client per 10 minutes, per instance.
AI_ASK_PER_CLIENT_LIMIT=12
# Existing global workflow reservations across providers/routes remain in place.
# Narration: at most two HTTP attempts; Director: at most three including retries.
# Every attempt also consumes hourly/daily/total allowances below, never refunded.
# Output allowance stays 1800 tokens per HTTP attempt.
AI_MINUTE_LIMIT=4
AI_HOURLY_LIMIT=30
AI_DAILY_LIMIT=60
# Persistent total allowance: does not reset with a process restart or a new day.
AI_TOTAL_LIMIT=100
# Shared per-attempt rolling-minute ceilings, with request spacing and provider
# cooldowns. Match the deployment's own rate limit (code allows up to 300 RPM /
# 300,000 TPM). Throughput is not a spending control; the dollar ledger is.
AI_REQUEST_MINUTE_LIMIT=30
AI_TOKEN_MINUTE_LIMIT=30000
# Canonical public origin for social previews; set before building a hosted release.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Explicit opt-in for bounded automatic investigation during playback.
# Requires AI_ENABLED, provider credentials and shared usage controls.
AI_PROACTIVE_ENABLED=false

# Shelved: the bounded investigator UI is no longer rendered. Setting this true
# forces every other AI path (including Ask the Analyst) offline. Keep false.
# Requires owner-approved durable TLS Redis and the separately initialized $10
# (or lower) permanent dollar ledger. No allowance is created by these settings.
AI_INVESTIGATOR_ENABLED=false
# Set only after checking the existing GlobalStandard deployment and retail rates.
AI_INVESTIGATOR_RATE_CARD=
# May only lower the existing three-attempt workflow ceiling (e.g. 2).
AI_INVESTIGATOR_MAX_HTTP_ATTEMPTS=3
# Approved deployment/rate-card pairs are pinned server-side. Adding Luna to an
# existing ledger requires operator approval of additionalRateCard; preserve all
# counters and the ceiling. Merely changing FOUNDRY_DEPLOYMENT cannot spend.
