{
  "name": "second-look",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "eval:ai": "vitest run tests/ai-evaluation.test.ts",
    "eval:live": "vitest run --config vitest.live.config.ts",
    "ai:check": "node scripts/check-ai-config.mjs",
    "cloudflare:build": "node scripts/build-cloudflare.mjs",
    "cloudflare:preview": "wrangler dev --ip 127.0.0.1 --port 3100",
    "cloudflare:deploy": "npm run cloudflare:build && wrangler deploy",
    "brand:build": "node scripts/generate-brand.mjs",
    "brand:review": "node scripts/review-brand.mjs",
    "data:statsbomb": "tsx scripts/import-statsbomb.ts",
    "data:benchmark": "tsx scripts/benchmark-football.ts",
    "eval:director": "vitest run tests/director.test.ts tests/director-evaluation.test.ts tests/hypothesis.test.ts tests/storylines.test.ts tests/intelligence-evaluation.test.ts tests/intelligence-graph.test.ts",
    "eval:director:live": "vitest run --config vitest.director-live.config.ts",
    "eval:foundry:bounded": "vitest run --config vitest.bounded-foundry.config.ts",
    "eval:director:offline": "vitest run tests/director-offline-evaluation.test.ts",
    "eval:investigation:prepare": "tsx scripts/prepare-investigation-evaluation.ts",
    "eval:editorial": "vitest run tests/editorial-baselines.test.ts",
    "eval:investigator": "vitest run tests/bounded-investigator.test.ts",
    "eval:investigator:editorial": "node --conditions=react-server --import tsx scripts/evaluate-investigator-editorial.ts",
    "eval:investigator:prepare": "node --conditions=react-server --import tsx scripts/prepare-investigator-feasibility.ts",
    "eval:analyst": "node --conditions=react-server --import tsx scripts/analyst-eval.ts",
    "ai:spend": "node scripts/spend-status.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@redis/client": "^6.3.0",
    "@tabler/icons-react": "^3.49.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fontkit": "^2.0.4",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wrangler": "^4.149.0"
  },
  "type": "module",
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
